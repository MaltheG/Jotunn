# Copy this file to .env and fill in your values.
# The bot reads these at startup via process.env.

# Your Discord bot token (from https://discord.com/developers/applications)
JOTUNN_TOKEN=

# MySQL connection string. Supports two formats:
#   URI:         mysql://user:password@host:3306/dbname
#   ADO.NET-style is not supported directly — use the URI format.
JOTUNN_DATABASE_URL=mysql://user:password@localhost:3306/jotunn
